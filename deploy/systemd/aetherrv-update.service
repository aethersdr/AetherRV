# AetherRV system update (aetherrv_update.sh), started from Settings → Updates through the admin helper.
# Not enabled: runs only when asked, once at a time.
[Unit]
Description=AetherRV system update (pacman -Syu, kernel/boot packages held)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/aetherrv/aetherrv_update.sh
Nice=10
IOSchedulingClass=idle
