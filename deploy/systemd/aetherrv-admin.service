# AetherRV admin helper (root): a fixed allowlist of settings actions (hostname, time zone, reboot,
# Wi-Fi via iwd, Tailscale, system update). Socket-activated; exits when idle.
[Unit]
Description=AetherRV admin helper
Requires=aetherrv-admin.socket

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/local/lib/aetherrv/aetherrv_admin.py
NoNewPrivileges=yes
PrivateTmp=yes
