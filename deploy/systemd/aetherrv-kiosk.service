[Unit]
Description=AetherRV touchscreen kiosk (sway + Chromium) on tty1
After=systemd-user-sessions.service aetherrv.service
Wants=aetherrv.service
Conflicts=getty@tty1.service
After=getty@tty1.service
# Boot splash: keep Plymouth's AetherRV splash up until sway draws (no console text in between).
After=plymouth-start.service plymouth-quit.service
Conflicts=plymouth-quit.service

[Service]
Type=simple
User=kiosk
PAMName=aetherrv-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# Touch-only kiosk: an invisible cursor theme (tools/make_blank_cursor.py) hides the compositor's pointer.
Environment=XCURSOR_PATH=/usr/share/aetherrv/cursors XCURSOR_THEME=default XCURSOR_SIZE=24
# Wait (up to 60 s) for the backend so Chromium doesn't land on an error page.
ExecStartPre=/bin/bash -c 'for i in $(seq 60); do (exec 3<>/dev/tcp/127.0.0.1/8080) 2>/dev/null && exit 0; sleep 1; done; exit 0'
ExecStartPre=-+/usr/bin/plymouth quit --retain-splash
# Clear any helper orphaned by a previous session (sway's children live in the login session scope).
ExecStartPre=-/usr/bin/pkill -u kiosk -f /opt/aetherrv/deploy/kiosk/screen_helper.py
ExecStart=/usr/bin/sway --config /opt/aetherrv/deploy/kiosk/sway.conf
Restart=always
RestartSec=3
StateDirectory=aetherrv-kiosk

[Install]
WantedBy=multi-user.target
