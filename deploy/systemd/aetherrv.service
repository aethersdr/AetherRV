[Unit]
Description=AetherRV backend (CAN, Victron, web UI)
Wants=network.target
After=network.target systemd-networkd.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=10
User=aetherrv
Group=aetherrv
ExecStart=/opt/aetherrv/.venv/bin/aetherrv -c /etc/aetherrv/aetherrv.toml
Restart=always
RestartSec=2
StateDirectory=aetherrv
# Hardening: needs only sockets (CAN, IP, unix) and its state dir.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_CAN AF_NETLINK
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
