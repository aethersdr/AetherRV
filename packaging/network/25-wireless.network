# Wi-Fi (any wlan interface; iwd joins, networkd addresses). Metric 600 so Wi-Fi never takes the default route
# from Ethernet (100), and the console doesn't wait for Wi-Fi at boot.
[Match]
Type=wlan

[Link]
RequiredForOnline=no

[Network]
DHCP=yes
IgnoreCarrierLoss=3s

[DHCPv4]
RouteMetric=600

[IPv6AcceptRA]
RouteMetric=600
