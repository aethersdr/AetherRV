# Your local deploy settings (copy to packaging/local.env, which is gitignored), used by tools/van-read.sh,
# tools/peplink_*.sh and tools/set_tomtom_key.sh.
AETHERRV_HOST=my-pi            # ssh host/alias of the AetherRV Pi
PEPLINK_ROUTER=192.0.2.1       # Peplink router address reachable from this machine (only for tools/peplink_*.sh)
