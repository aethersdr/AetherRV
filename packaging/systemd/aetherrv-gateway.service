[Unit]
Description=AetherRV HTTP + WebSocket for the UI
PartOf=aetherrv.target
# Wants, not Requires: a broker restart must not stop this service (it rides it out).
Wants=aetherrv-bus.service
# Not after network.target: it binds [web] host (0.0.0.0 by default) and the touchscreen reaches it on loopback,
# so the panel need not wait for nftables and networkd at boot (power-on, docs/UI-RUNTIME-BENCHMARK.md §8).
After=aetherrv-bus.service

[Service]
Type=notify
NotifyAccess=main
User=aetherrv
Group=aetherrv
ExecStart=/opt/aetherrv-rs/bin/aetherrv-gateway -c /etc/aetherrv/aetherrv.toml
Restart=always
RestartSec=1
StateDirectory=aetherrv
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_CAN AF_NETLINK
WatchdogSec=10
PrivateDevices=yes

[Install]
WantedBy=aetherrv.target
