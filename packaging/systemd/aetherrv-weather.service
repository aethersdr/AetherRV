[Unit]
Description=AetherRV radar recorder, motion fields, traffic proxy
PartOf=aetherrv.target
# Wants, not Requires: a broker restart must not stop this service (it rides it out).
Wants=aetherrv-bus.service
After=aetherrv-bus.service network.target systemd-networkd.service

[Service]
Type=notify
NotifyAccess=main
User=aetherrv
Group=aetherrv
ExecStart=/opt/aetherrv-rs/bin/aetherrv-weather -c /etc/aetherrv/aetherrv.toml
Restart=always
RestartSec=1
StateDirectory=aetherrv
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_CAN AF_NETLINK
WatchdogSec=10
PrivateDevices=yes
RuntimeDirectory=aetherrv/weather
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=aetherrv.target
