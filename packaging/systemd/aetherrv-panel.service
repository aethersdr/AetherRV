# AetherRV panel: sway + the UI runtime on tty1 (replaces the Python system's aetherrv-kiosk.service).
[Unit]
Description=AetherRV touchscreen panel (sway + UI runtime) on tty1
# Not after systemd-user-sessions.service (which waits for network.target): the panel's PAM stack has no
# pam_nologin, so the panel can log in before /run/nologin is removed. pam_systemd needs logind. (logind still orders
# every session's scope after systemd-user-sessions, so the session itself waits for network.target; the PAM stack's
# class=user-light only spares it the user service manager: docs/UI-RUNTIME-BENCHMARK.md §8.)
After=systemd-logind.service aetherrv-gateway.service
Wants=aetherrv-gateway.service
Conflicts=getty@tty1.service aetherrv-kiosk.service
After=getty@tty1.service
# Boot splash: keep Plymouth's AetherRV splash up until sway draws (as the Python kiosk does).
After=plymouth-start.service plymouth-quit.service
Conflicts=plymouth-quit.service

[Service]
Type=simple
User=kiosk
PAMName=aetherrv-panel
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=XCURSOR_PATH=/usr/share/aetherrv/cursors XCURSOR_THEME=default XCURSOR_SIZE=24
EnvironmentFile=-/etc/aetherrv/panel.env
# Wait (up to 60 s) for the gateway so the runtime doesn't land on an error page; the UI shows skeletons at once.
ExecStartPre=/bin/bash -c 'for i in $(seq 60); do (exec 3<>/dev/tcp/127.0.0.1/8080) 2>/dev/null && exit 0; sleep 0.25; done; exit 0'
# Started early now (not after network.target): wait until the HDMI display reads connected and steady for 2 s (at most
# 20 s; packaging/panel/wait-hdmi.sh). In the van sway started at 4 s found no display and the panel stayed dark
# (2026-11-24); the splash stays up while this waits.
ExecStartPre=/bin/bash /opt/aetherrv-rs/panel/wait-hdmi.sh
ExecStartPre=-+/usr/bin/plymouth quit --retain-splash
ExecStartPre=-/usr/bin/pkill -u kiosk -f /opt/aetherrv-rs/panel/screen.sh
ExecStartPre=-/usr/bin/pkill -u kiosk -x aetherrv-screen
# and a WPE launcher left from a session that died some other way (comm is cut to 15 characters, so match the path)
ExecStartPre=-/usr/bin/pkill -u kiosk -f ^/opt/aetherrv-rs/bin/aetherrv-panel-wpe
ExecStart=/usr/bin/sway --config /opt/aetherrv-rs/panel/sway.conf
Restart=always
RestartSec=3
StateDirectory=aetherrv-panel

[Install]
WantedBy=multi-user.target
