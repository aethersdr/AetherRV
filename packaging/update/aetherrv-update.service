# AetherRV system update (aetherrv-update.sh), started from Settings → Updates through aetherrv-admind.
# Not enabled: runs only when asked, once at a time. Kept out of packaging/systemd/ (units.txt): the cutover enables
# and the rollback stops every unit listed there, and neither may touch an update.
[Unit]
Description=AetherRV system update (pacman -Syu, kernel/boot packages held)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/aetherrv-rs/bin/aetherrv-update.sh
Nice=10
IOSchedulingClass=idle
